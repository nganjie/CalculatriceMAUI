<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculatriceMAUI.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#121216}"
             SizeChanged="OnPageSizeChanged">

    <ContentPage.Resources>
        <x:Double x:Key="KeyFontSize">24</x:Double>
        <x:Double x:Key="SmallKeyFontSize">16</x:Double>

        <Style x:Key="KeyBase" TargetType="Button">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="{DynamicResource KeyFontSize}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="MinimumHeightRequest" Value="0" />
            <Setter Property="MinimumWidthRequest" Value="0" />
            <Setter Property="LineBreakMode" Value="NoWrap" />
        </Style>

        <Style x:Key="DigitKey" TargetType="Button" BasedOn="{StaticResource KeyBase}">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C34}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1C1C1E, Dark=#F2F2F7}" />
        </Style>

        <Style x:Key="FunctionKey" TargetType="Button" BasedOn="{StaticResource KeyBase}">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#D9D9E3, Dark=#44444E}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1C1C1E, Dark=#F2F2F7}" />
        </Style>

        <Style x:Key="OperatorKey" TargetType="Button" BasedOn="{StaticResource KeyBase}">
            <Setter Property="BackgroundColor" Value="#FF9F0A" />
            <Setter Property="TextColor" Value="#FFFFFF" />
        </Style>

        <Style x:Key="EqualsKey" TargetType="Button" BasedOn="{StaticResource KeyBase}">
            <Setter Property="BackgroundColor" Value="#512BD4" />
            <Setter Property="TextColor" Value="#FFFFFF" />
        </Style>

        <Style x:Key="AdvancedKey" TargetType="Button" BasedOn="{StaticResource KeyBase}">
            <Setter Property="FontSize" Value="{DynamicResource SmallKeyFontSize}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="FlexLayout.Grow" Value="1" />
            <Setter Property="FlexLayout.Basis" Value="0" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E8E8F0, Dark=#23232A}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#512BD4, Dark=#AC99EA}" />
        </Style>
    </ContentPage.Resources>

    <!-- Grid racine : écran en haut / clavier en bas en portrait,
         côte à côte en paysage (réorganisé dans OnPageSizeChanged). -->
    <Grid x:Name="RootGrid"
          Padding="12"
          RowSpacing="12"
          ColumnSpacing="12"
          RowDefinitions="2*,5*"
          ColumnDefinitions="*">

        <!-- Zone d'affichage -->
        <Border x:Name="DisplayBorder"
                Grid.Row="0"
                Padding="16,10"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C22}"
                SizeChanged="OnDisplaySizeChanged">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto,*">

                <HorizontalStackLayout Grid.Row="0" Spacing="8">
                    <Label Text="CALCULATRICE"
                           FontSize="12"
                           FontFamily="OpenSansSemibold"
                           CharacterSpacing="2"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8E8E93}" />
                    <Border x:Name="MemoryIndicator"
                            IsVisible="False"
                            Padding="6,0"
                            StrokeThickness="0"
                            BackgroundColor="#512BD4"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                        </Border.StrokeShape>
                        <Label Text="M"
                               FontSize="11"
                               FontFamily="OpenSansSemibold"
                               TextColor="#FFFFFF" />
                    </Border>
                </HorizontalStackLayout>

                <VerticalStackLayout Grid.Row="1"
                                     VerticalOptions="End"
                                     Spacing="2">

                    <!-- Opération en cours, défilable si elle est trop longue -->
                    <ScrollView x:Name="ExpressionScroll"
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                HorizontalOptions="End">
                        <Label x:Name="ExpressionLabel"
                               Text=" "
                               FontSize="20"
                               LineBreakMode="NoWrap"
                               TextColor="{AppThemeBinding Light=#8E8E93, Dark=#9A9AA2}"
                               SemanticProperties.Description="Opération en cours" />
                    </ScrollView>

                    <!-- Résultat -->
                    <Label x:Name="ResultLabel"
                           Text="0"
                           FontSize="56"
                           FontFamily="OpenSansSemibold"
                           MaxLines="1"
                           LineBreakMode="HeadTruncation"
                           HorizontalTextAlignment="End"
                           TextColor="{AppThemeBinding Light=#1C1C1E, Dark=#FFFFFF}"
                           SemanticProperties.HeadingLevel="Level1"
                           SemanticProperties.Description="Résultat" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Zone des touches -->
        <Grid x:Name="PadGrid"
              Grid.Row="1"
              RowSpacing="8"
              RowDefinitions="*,5*">

            <!-- Fonctions avancées et mémoire -->
            <FlexLayout Grid.Row="0"
                        Margin="-3,0"
                        Direction="Row"
                        Wrap="NoWrap"
                        AlignItems="Stretch"
                        JustifyContent="SpaceBetween">
                <Button Text="MC" Style="{StaticResource AdvancedKey}" Clicked="OnMemoryClearClicked"
                        SemanticProperties.Description="Effacer la mémoire" />
                <Button Text="MR" Style="{StaticResource AdvancedKey}" Clicked="OnMemoryRecallClicked"
                        SemanticProperties.Description="Rappeler la mémoire" />
                <Button Text="M+" Style="{StaticResource AdvancedKey}" Clicked="OnMemoryAddClicked"
                        SemanticProperties.Description="Ajouter à la mémoire" />
                <Button Text="M−" Style="{StaticResource AdvancedKey}" Clicked="OnMemorySubtractClicked"
                        SemanticProperties.Description="Soustraire de la mémoire" />
                <Button Text="√" Style="{StaticResource AdvancedKey}" Clicked="OnSquareRootClicked"
                        SemanticProperties.Description="Racine carrée" />
                <Button Text="x²" Style="{StaticResource AdvancedKey}" Clicked="OnSquareClicked"
                        SemanticProperties.Description="Carré" />
                <Button Text="1/x" Style="{StaticResource AdvancedKey}" Clicked="OnInverseClicked"
                        SemanticProperties.Description="Inverse" />
            </FlexLayout>

            <!-- Clavier principal -->
            <Grid Grid.Row="1"
                  RowSpacing="8"
                  ColumnSpacing="8"
                  RowDefinitions="*,*,*,*,*"
                  ColumnDefinitions="*,*,*,*">

                <Button Grid.Row="0" Grid.Column="0" Text="AC"
                        Style="{StaticResource FunctionKey}" Clicked="OnClearClicked"
                        SemanticProperties.Description="Remise à zéro" />
                <Button Grid.Row="0" Grid.Column="1" Text="⌫"
                        Style="{StaticResource FunctionKey}" Clicked="OnBackspaceClicked"
                        SemanticProperties.Description="Effacer le dernier caractère" />
                <Button Grid.Row="0" Grid.Column="2" Text="%"
                        Style="{StaticResource FunctionKey}" Clicked="OnPercentClicked"
                        SemanticProperties.Description="Pourcentage" />
                <Button Grid.Row="0" Grid.Column="3" Text="÷" CommandParameter="Divide"
                        Style="{StaticResource OperatorKey}" Clicked="OnOperatorClicked"
                        SemanticProperties.Description="Diviser" />

                <Button Grid.Row="1" Grid.Column="0" Text="7" Style="{StaticResource DigitKey}" Clicked="OnDigitClicked" />
                <Button Grid.Row="1" Grid.Column="1" Text="8" Style="{StaticResource DigitKey}" Clicked="OnDigitClicked" />
                <Button Grid.Row="1" Grid.Column="2" Text="9" Style="{StaticResource DigitKey}" Clicked="OnDigitClicked" />
                <Button Grid.Row="1" Grid.Column="3" Text="×" CommandParameter="Multiply"
                        Style="{StaticResource OperatorKey}" Clicked="OnOperatorClicked"
                        SemanticProperties.Description="Multiplier" />

                <Button Grid.Row="2" Grid.Column="0" Text="4" Style="{StaticResource DigitKey}" Clicked="OnDigitClicked" />
                <Button Grid.Row="2" Grid.Column="1" Text="5" Style="{StaticResource DigitKey}" Clicked="OnDigitClicked" />
                <Button Grid.Row="2" Grid.Column="2" Text="6" Style="{StaticResource DigitKey}" Clicked="OnDigitClicked" />
                <Button Grid.Row="2" Grid.Column="3" Text="−" CommandParameter="Subtract"
                        Style="{StaticResource OperatorKey}" Clicked="OnOperatorClicked"
                        SemanticProperties.Description="Soustraire" />

                <Button Grid.Row="3" Grid.Column="0" Text="1" Style="{StaticResource DigitKey}" Clicked="OnDigitClicked" />
                <Button Grid.Row="3" Grid.Column="1" Text="2" Style="{StaticResource DigitKey}" Clicked="OnDigitClicked" />
                <Button Grid.Row="3" Grid.Column="2" Text="3" Style="{StaticResource DigitKey}" Clicked="OnDigitClicked" />
                <Button Grid.Row="3" Grid.Column="3" Text="+" CommandParameter="Add"
                        Style="{StaticResource OperatorKey}" Clicked="OnOperatorClicked"
                        SemanticProperties.Description="Additionner" />

                <Button Grid.Row="4" Grid.Column="0" Text="±"
                        Style="{StaticResource FunctionKey}" Clicked="OnToggleSignClicked"
                        SemanticProperties.Description="Changer de signe" />
                <Button Grid.Row="4" Grid.Column="1" Text="0" Style="{StaticResource DigitKey}" Clicked="OnDigitClicked" />
                <Button Grid.Row="4" Grid.Column="2" Text=","
                        Style="{StaticResource DigitKey}" Clicked="OnDecimalClicked"
                        SemanticProperties.Description="Virgule" />
                <Button Grid.Row="4" Grid.Column="3" Text="="
                        Style="{StaticResource EqualsKey}" Clicked="OnEqualsClicked"
                        SemanticProperties.Description="Égal" />
            </Grid>
        </Grid>
    </Grid>

</ContentPage>
